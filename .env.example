# Copy to .env and edit as needed; setup.sh loads it automatically
HF_HOME=./hf-cache
HF_HUB_CACHE=./hf-cache/hub
HF_ENDPOINT=https://hf-mirror.com

# The mirror does not proxy Xet CAS (returns 401); force the classic LFS resolve path
HF_HUB_DISABLE_XET=1
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# Models in the released benchmark (4: baseline eval -> LoRA fine-tuning -> after eval; defaults usually need no change)
VL_QWEN3VL2B_ID=Qwen/Qwen3-VL-2B-Instruct      # qwen3vl2b (primary lightweight)
VL_QWEN7B_ID=Qwen/Qwen2.5-VL-7B-Instruct
VL_QWEN3VL8B_ID=Qwen/Qwen3-VL-8B-Instruct
VL_MOLMO4B_ID=allenai/Molmo2-4B
# Registered but not part of the released benchmark; uncomment if you run them yourself:
# VL_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct             # qwen3b (retired)
# VL_INTERNVL8B_ID=OpenGVLab/InternVL3_5-8B-HF        # internvl8b (requires the -HF suffix)

# Active datasets (images embedded in parquet; split names are in vlm/config.py)
VL_SNLI_VE_TRAIN_ID=Multimodal-Fatima/SNLI-VE_train
VL_SNLI_VE_TEST_ID=Multimodal-Fatima/SNLI-VE_test
VL_VQAV2_TRAIN_ID=Multimodal-Fatima/VQAv2_train
VL_VQAV2_VAL_ID=Multimodal-Fatima/VQAv2_validation
VL_VISUAL7W_ID=mm-eval/Visual7W
# Future datasets (ids recorded in config.ADV_DATASETS; no converter yet, out of scope for this release)
# VL_CHARTQA_ID=HuggingFaceM4/ChartQA
# VL_DOCVQA_ID=lmms-lab/DocVQA

# Distillation teacher (optional, code in vlm/datasets/distill.py; no experiment reported yet)
# Requirements: OpenAI-compatible chat.completions + image-text input + first-token logprobs
# VL_TEACHER_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VL_TEACHER_API_MODEL=qwen3-vl-plus
# VL_TEACHER_API_KEY=sk-...        # or export VL_TEACHER_API_KEY=...
